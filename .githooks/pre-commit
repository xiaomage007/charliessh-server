#!/bin/sh
# 提交前扫描暂存区内容，命中疑似密钥则拒绝提交。
# 通过 core.hooksPath=.githooks 启用，规则随仓库走，克隆后自动生效。
MATCHES=$(git grep --cached -n -E \
  'sk-[A-Za-z0-9_-]{20,}|bce-v3/ALTAK-[A-Za-z0-9]{6,}/[a-f0-9]{20,}|AIza[A-Za-z0-9_-]{30,}|ghp_[A-Za-z0-9]{20,}|AKIA[A-Z0-9]{16}|xox[baprs]-[A-Za-z0-9-]{10,}' \
  -- . ':!.githooks/*' || true)

if [ -n "$MATCHES" ]; then
  echo "提交被拒绝：检测到疑似密钥"
  echo ""
  echo "$MATCHES"
  echo ""
  echo "处理方式：密钥写入 application-local.yml（已 gitignore），"
  echo "配置文件改为引用环境变量，如 \${BAIDU_MCP_API_KEY}。"
  exit 1
fi
